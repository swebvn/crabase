{
  "name": "crabase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server:dev": "cd server && php start.php start",
    "server:start": "cd server && php start.php start -d",
    "server:restart": "cd server && php start.php start -d",
    "server:reload": "cd server && php start.php reload -g",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test web/tests/*.test.mjs server/tests/terminal_host.mjs && python3 server/tests/migrations.py && php server/tests/auth.php && php server/tests/models.php && php server/tests/artifacts.php && php server/tests/attachments.php && php server/tests/folders.php && php server/tests/project_workspace.php && php server/tests/worktrees.php && php server/tests/agent_activity.php && php server/tests/parallel_chats.php && python3 server/tests/smoke.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lydell/node-pty": "^1.1.0",
    "@pierre/diffs": "^1.6.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "@wterm/dom": "^0.5.6",
    "@wterm/ghostty": "^0.5.6",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@pierre/trees": {
      "@pierre/theming": "1.0.2"
    }
  }
}
