{
  "name": "crabase/server",
  "type": "project",
  "keywords": [
    "crabphp",
    "codex",
    "workspace"
  ],
  "license": "MIT",
  "description": "CrabPHP backend for the Crabase shared coding workspace.",
  "require": {
    "php": ">=8.4",
    "crabphp/framework": "^0.2",
    "robmorgan/phinx": "^0.16"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/crabphp/framework"
    }
  ],
  "autoload": {
    "psr-4": {
      "app\\": "./app/",
      "App\\": "./app/"
    },
    "files": ["app/functions.php"]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {}
}
